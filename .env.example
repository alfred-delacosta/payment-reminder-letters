# Copy to .env (or .env.local) for local overrides. Never commit .env files.

# Base path for Vite (leading and trailing slash). Default is /paymentreminders/.
# Use / to run the app at the site root during local work.
# VITE_BASE_PATH=/paymentreminders/

# Absolute app URL for og/twitter/canonical tags (no trailing slash required).
# Default is https://advancedsoftwareandaisolutions.com/paymentreminders
# SITE_URL=https://advancedsoftwareandaisolutions.com/paymentreminders

# Phase 2 only (leave commented in Phase 1):
# VITE_PULSE_API=
# VITE_PULSE_SITE=pr
