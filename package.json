{
  "name": "payment-reminder-letters",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free offline Payment Reminder Letters tool for trades owners",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
